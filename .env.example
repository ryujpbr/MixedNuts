# ---------------------------------------------------------------- server
# Required. No default: forgetting it must fail loudly, not fall back to
# unverified identities.
#   dev       local only, no verification at all
#   firebase  verified Firebase ID tokens
AUTH_MODE=dev

# Set automatically by Railway. Only needed locally.
PORT=8787

# Built client, served from the same origin so https gives wss:// for free.
STATIC_DIR=apps/web/dist

# Firebase credentials, one of:
#   the service account JSON pasted as a single-line string (use this on Railway)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#   or a path to the same file, for local use
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---------------------------------------------------------------- client
# Read at BUILD time by Vite, so these must exist when `npm run build` runs.
# Leave them unset to keep the local sign-in (no verification).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Do NOT set NODE_ENV=production on Railway: it makes npm skip devDependencies,
# and the build needs vite and esbuild from there.
