{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@mixednuts/engine": ["packages/engine/src/index.ts"],
      "@mixednuts/protocol": ["packages/protocol/src/index.ts"]
    }
  },
  "include": ["packages", "apps"]
}
